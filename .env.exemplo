# LA Carta — configuração de ambiente
# Copie para .env e ajuste.

CARTA_AMBIENTE=desenvolvimento
PORTA=5209
HOST=127.0.0.1

# Banco: sqlite (padrão, zero setup — arquivo em ./dados/carta.db)
# ou postgres (produção — exige DATABASE_URL e o pacote pg).
CARTA_BANCO=sqlite
CARTA_SQLITE=./dados/carta.db
# DATABASE_URL=postgres://la_carta_app:troque-esta-senha@127.0.0.1:5432/la_carta

# Segredo das sessões (gere um novo: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))")
CARTA_SEGREDO_SESSAO=troque-este-segredo

# Quantos proxies reversos existem na frente do serviço (0 em dev; 1 atrás do nginx).
PROXIES_CONFIAVEIS=0

# Usuário inicial criado por `npm run semear` (a senha é impressa no terminal se não vier daqui).
# CARTA_EMAIL_INICIAL=luiz@lacarta.local
# CARTA_SENHA_INICIAL=
