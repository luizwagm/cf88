[Unit]
Description=LA Carta — cópia de segurança do caderno (dados/carta.db)

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/projetos/LA-Carta
ExecStart=/opt/node24/bin/node ferramentas/copia.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# VACUUM INTO lê o banco em WAL (precisa escrever -shm na pasta do banco) e
# grava a cópia em backups/, que o LA Backup leva para o R2 às 04:00.
ReadWritePaths=-/var/www/projetos/LA-Carta/dados
ReadWritePaths=-/var/www/projetos/LA-Carta/backups
